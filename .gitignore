# ==========================================
# ServiceHub - Root .gitignore (Full-Stack)
# ==========================================

# Dependencies (covers backend, frontend & monorepo packages)
node_modules/
.pnp
.pnp.js

# Build & Compilation Outputs
dist/
build/
out/
.next/
.nuxt/
.turbo/
.output/
*.tsbuildinfo

# Environment Variables & Secrets (never commit sensitive credentials)
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.example

# Logs & Debuggers
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Testing & Code Coverage
coverage/
.nyc_output/

# IDEs & Editor Configuration
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.sublime-project
*.sublime-workspace
*.swp
*.swo

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# Temporary & Runtime Files
.temp/
.tmp/
pids/
*.pid
*.seed
*.pid.lock

# Prisma Notes:
# Do NOT ignore contract.json, contract.d.ts, or migrations/ - they must be tracked.
.agents/
.claude/
.cursor/
.devin/